{
  "name": "rutin",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r build",
    "dev": "vp run -F website -F api dev",
    "dev:website": "vp run website#dev",
    "dev:api": "vp run api#dev",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite-plus": "1.8.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.3",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
